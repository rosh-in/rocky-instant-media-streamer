LETTERBOXD_USERNAME=your_letterboxd_username
TMDB_API_KEY=your_tmdb_api_key
SQLITE_PATH=data/rocky.db
LETTERBOXD_MAX_PAGES=5
RADARR_ENABLED=false
RADARR_URL=http://localhost:7878
RADARR_API_KEY=your_radarr_api_key
RADARR_ROOT_FOLDER=/data/media/movies
RADARR_QUALITY_PROFILE_ID=1
RADARR_MONITORED=true
RADARR_SEARCH_ON_ADD=false
RADARR_DRY_RUN=true
JUSTWATCH_ENABLED=true
JUSTWATCH_COUNTRY=IN
JUSTWATCH_LANGUAGE=en
JUSTWATCH_REFRESH_HOURS=168
JUSTWATCH_MAX_RESULTS=3
JUSTWATCH_BEST_ONLY=true
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=your_jellyfin_api_key
JELLYFIN_USERNAME=your_jellyfin_username
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
GEMINI_API_KEY=your_gemini_api_key
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_RATE_LIMIT_WINDOW_SECONDS=20
TELEGRAM_RATE_LIMIT_MAX_MESSAGES=8

# VPN credentials for the media stack (set in mediaserver/.env)
# See mediaserver/.env.example for VPN_SERVICE_PROVIDER, VPN_TYPE,
# WIREGUARD_PRIVATE_KEY, WIREGUARD_ADDRESSES, and server details.
# These are required for qBittorrent traffic to route through gluetun.
